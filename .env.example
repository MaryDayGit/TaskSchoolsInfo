# Copy to .env for local development: cp .env.example .env

# PostgreSQL connection string
DATABASE_URL=postgres://infoklas:infoklas@localhost:5432/infoklas

# Secret for signing login cookies: a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# The first teacher can always register. Set to "true" to let more teachers sign up.
TEACHER_SIGNUP=false

# development | production
NODE_ENV=development
PORT=3000

# Production only: serve the built web app and trust the hosting proxy (Render, nginx…)
# WEB_DIST_DIR=../web/dist
# TRUST_PROXY=true
